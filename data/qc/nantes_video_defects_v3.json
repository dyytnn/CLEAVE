 "tiers": {
  "A": "label-image mismatch: removed from training",
  "B": "image artefact, label correct: kept (labels cut at cutoff_h)",
  "C": "atypical biology: kept everywhere"
 },
 "categories": {
  "timeline_mismatch": {
   "tier": "A",
   "description": "The images run on a different clock from the annotation: pairing the k-th image with annotation frame k lets the label drift, by up to tens of hours by the end of the video."
  },
  "no_division": {
   "tier": "A",
   "description": "The embryo stays a single cell and never divides, while the annotation records divisions."
  },
  "blank_throughout": {
   "tier": "A",
   "description": "Every frame is a featureless bright well; no embryo is visible."
  },
  "annotation_ahead": {
   "tier": "A",
   "description": "The annotated onsets run ahead of what the images show, by one to two division stages."
  },
  "embryo_removed": {
   "tier": "B",
   "description": "The well empties partway through the recording (removal for transfer or freezing, or hatching out of view) and the release extends the last annotated phase to the end."
  },
  "dark_frames": {
   "tier": "B",
   "description": "Frames in the middle of the recording are under-exposed to near black."
  },
  "out_of_focus": {
   "tier": "B",
   "description": "Frames are an out-of-focus blur."
  },
  "abrupt_cleavage": {
   "tier": "C",
   "description": "Direct cleavage from one cell to three or more, or to a fragmented mass, within minutes."
  },
  "heavy_fragmentation": {
   "tier": "C",
   "description": "Heavy fragmentation makes the cell count, and so the stage, hard to read."
  }
 },
