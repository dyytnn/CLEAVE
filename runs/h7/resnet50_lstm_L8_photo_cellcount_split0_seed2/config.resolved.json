{
  "experiment": {
    "id": "resnet50_lstm_L8_photo_cellcount_split0",
    "seed": 0,
    "out_root": "runs/h7",
    "tags": [
      "T8",
      "photometric",
      "cellcount",
      "backbone"
    ]
  },
  "data": {
    "dataset": "nantes_clips",
    "manifest": "data/derived/nantes_manifest_F0.csv",
    "split": "data/splits/nantes_official/split0.csv",
    "plane": "embryo_dataset",
    "planes": null,
    "resize": 250,
    "crop": 224,
    "clip_len": 8,
    "clips_per_video": "auto",
    "official_offset": false,
    "cache_dir": "data/cache/nantes_250",
    "photometric": {
      "brightness": 0.2,
      "contrast": 0.3,
      "gamma": 0.3,
      "p": 0.8
    },
    "instance_norm": true
  },
  "model": {
    "type": "seq_kinetic",
    "backbone": {
      "name": "resnet50",
      "pretrained": true
    },
    "head": {
      "name": "lstm",
      "hidden": 1024,
      "layers": 2
    },
    "num_classes": 16,
    "dropout": 0.5,
    "aux": {
      "name": "cellcount_ordinal",
      "levels": 9
    }
  },
  "loss": {
    "name": "ce_cellcount",
    "lam": 0.5
  },
  "optimizer": {
    "name": "sgd",
    "lr": 0.001,
    "momentum": 0.9,
    "weight_decay": 0.0
  },
  "scheduler": {
    "name": "none"
  },
  "training": {
    "epochs": 10,
    "batch_size": 6,
    "eval_len": 150,
    "eval_batch_size": 150,
    "num_workers": 8,
    "amp": true,
    "monitor": "p_v"
  },
  "decoder": {
    "name": "viterbi"
  }
}