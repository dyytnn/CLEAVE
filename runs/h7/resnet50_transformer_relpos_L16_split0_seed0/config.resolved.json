{
  "experiment": {
    "id": "resnet50_transformer_relpos_L16_split0",
    "seed": 0,
    "out_root": "runs/h7",
    "tags": [
      "head",
      "relpos",
      "modern",
      "backbone"
    ]
  },
  "data": {
    "dataset": "nantes_clips",
    "manifest": "data/derived/nantes_manifest_F0.csv",
    "split": "data/splits/nantes_official/split0.csv",
    "plane": "embryo_dataset",
    "planes": null,
    "resize": 250,
    "crop": 224,
    "clip_len": 16,
    "clips_per_video": "auto",
    "official_offset": false,
    "cache_dir": "data/cache/nantes_250"
  },
  "model": {
    "type": "seq_kinetic",
    "backbone": {
      "name": "resnet50",
      "pretrained": true
    },
    "head": {
      "name": "transformer_relpos",
      "hidden": 512,
      "layers": 2
