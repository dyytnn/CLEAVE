  "scheduler": {
    "name": "warmup_cosine",
    "warmup_epochs": 1
  },
  "training": {
    "epochs": 10,
    "batch_size": 4,
    "eval_len": 150,
    "eval_batch_size": 150,
    "num_workers": 8,
    "amp": true,
    "monitor": "p_v"
  },
  "decoder": {
    "name": "viterbi"
