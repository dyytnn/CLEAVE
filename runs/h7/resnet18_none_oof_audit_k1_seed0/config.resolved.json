{
  "experiment": {
    "id": "resnet18_none_oof_audit_k1",
    "seed": 0,
    "out_root": "runs/h7",
    "tags": [
      "oof_audit",
      "timeline_audit"
    ],
    "notes": "per-frame classifier for the out-of-fold timeline audit; only data.split differs"
  },
  "data": {
    "dataset": "nantes_frames",
    "manifest": "data/derived/nantes_manifest_F0.csv",
    "split": "data/splits/nantes_oof_audit_v1_k1.json",
    "plane": "embryo_dataset",
    "planes": null,
    "resize": 250,
    "crop": 224,
    "clip_len": 4,
    "clips_per_video": "auto",
    "official_offset": false,
    "cache_dir": "data/cache/nantes_250",
    "split_mode": "video"
  },
  "model": {
    "type": "seq_kinetic",
    "backbone": {
      "name": "resnet18",
      "pretrained": true
    },
    "head": {
      "name": "none"
    },
    "num_classes": 16,
    "dropout": 0.5
  },
  "loss": {
    "name": "ce"
  },
  "optimizer": {
    "name": "sgd",
    "lr": 0.001,
    "momentum": 0.9,
    "weight_decay": 0.0
  },
  "scheduler": {
    "name": "none"
  },
  "training": {
    "epochs": 10,
    "batch_size": 40,
    "eval_len": 150,
    "eval_batch_size": 150,
    "num_workers": 8,
    "amp": true,
    "monitor": "p_v"
  },
  "decoder": {
    "name": "viterbi"
  }
}