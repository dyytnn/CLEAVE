{
  "experiment": {
    "id": "kinetic_cnn_lstm_L4_split0",
    "seed": 0,
    "out_root": "runs/h7",
    "tags": [
      "ablation",
      "no_pretraining"
    ]
  },
  "data": {
    "dataset": "nantes_clips",
    "manifest": "data/derived/nantes_manifest_F0.csv",
    "split": "data/splits/nantes_official/split0.csv",
    "plane": "embryo_dataset",
    "planes": null,
    "resize": 250,
    "crop": 224,
    "clip_len": 4,
    "clips_per_video": "auto",
    "official_offset": false,
    "cache_dir": "data/cache/nantes_250"
  },
  "model": {
    "type": "seq_kinetic",
    "backbone": {
      "name": "kinetic_cnn",
      "base_channels": 32,
      "pretrained": false
    },
    "head": {
      "name": "lstm",
      "hidden": 1024,
      "layers": 2
    },
    "num_classes": 16,
    "dropout": 0.5
  },
  "loss": {
    "name": "ce"
  },
  "optimizer": {
    "name": "adamw",
    "lr": 0.0003,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "none"
  },
  "training": {
    "epochs": 10,
    "batch_size": 10,
    "eval_len": 150,
    "eval_batch_size": 150,
    "num_workers": 8,
    "amp": true,
    "monitor": "p_v"
  },
  "decoder": {
    "name": "viterbi"
  }
}